{
  "name": "1panel-local-apps",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \".github/lib/*.test.mjs\"",
    "lint": "node .github/bin/lint-apps.mjs",
    "lint:deploy": "node .github/bin/lint-apps.mjs --manifest",
    "smoke": "node .github/bin/smoke-test.mjs",
    "validate:batch": "node .github/bin/validate-update-batch.mjs",
    "docs:check": "node .github/bin/check-docs.mjs",
    "open-pr": "node .github/bin/open-update-pr.mjs",
    "detect": "node .github/scripts/detect-updates.mjs",
    "detect:dry-run": "node .github/scripts/detect-updates.mjs --dry-run"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^3.23.0"
  }
}
